# ============================================================
# Polyglot Persistence Layer — Environment Variables
# Copy this file to .env and fill in the values before running.
# DO NOT commit your real .env file to version control.
# ============================================================

# ─── PostgreSQL (Relational Store) ───────────────────────────
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=logistics_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── MongoDB (Document Store) ────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=logistics_user
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=logistics_db

# ─── Neo4j (Graph Store) ─────────────────────────────────────
# NEO4J_AUTH must be in the format "username/password"
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_URI=bolt://neo4j:7687

# ─── Application ─────────────────────────────────────────────
API_PORT=3000
LOG_FILE=/data/events.log
RETRY_QUEUE_FILE=/data/retry_queue.json
